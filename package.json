{
  "name": "pageshot-extension",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:store": "cross-env BUILD_VARIANT=store vite build",
    "build:cdp": "cross-env BUILD_VARIANT=cdp vite build",
    "build": "pnpm build:store",
    "build:all": "pnpm build:store && pnpm build:cdp",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "fixtures:serve": "vite --config test/fixtures/vite.config.ts --host 127.0.0.1",
    "check:manifest": "tsx scripts/check-manifest.ts",
    "check:content-assets": "tsx scripts/check-content-assets.ts",
    "check:bundle": "tsx scripts/check-bundle-size.ts",
    "traceability": "tsx scripts/traceability.ts",
    "zip": "tsx scripts/build-zip.ts"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.4.0",
    "@crxjs/vite-plugin": "2.0.0-beta.28",
    "@preact/signals": "2.0.1",
    "comlink": "4.4.2",
    "dexie": "4.0.11",
    "fflate": "0.8.2",
    "nanoid": "5.0.9",
    "pixelmatch": "6.0.0",
    "preact": "10.26.4",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/chrome": "0.0.287",
    "@types/node": "22.13.4",
    "@types/pixelmatch": "5.2.6",
    "@typescript-eslint/eslint-plugin": "8.24.0",
    "@typescript-eslint/parser": "8.24.0",
    "@vitest/coverage-v8": "3.0.5",
    "cross-env": "7.0.3",
    "eslint": "9.20.1",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "happy-dom": "16.7.2",
    "prettier": "3.5.1",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "vitest": "3.0.5"
  }
}
